# Durable Firestore branch. Leave disabled for the Redis-only demo.
FIRESTORE_SYNC_ENABLED=true
FIREBASE_PROJECT_ID=test-redis-83cd7
# Point this to a service account JSON outside the repository, or use ADC in Google Cloud.
# Keep the same value while Redis stream history/checkpoints belong to the same Redis dataset.
FIRESTORE_SOURCE_EPOCH=redis-session-app-v1
# Optional: use a persistent secret to derive opaque session references across app restarts.
FIRESTORE_SESSION_REF_KEY=replace-with-a-long-random-secret
FIRESTORE_SYNC_POLL_MS=1000
FIRESTORE_SYNC_BATCH_SIZE=50
