  "description": "Ứng dụng minh họa quản lý phiên đăng nhập bằng Redis Session và quan sát bằng Redis Insight",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seedUsers.js",
